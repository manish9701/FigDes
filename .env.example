# Server
PORT=8787
HOST=127.0.0.1

# Guards POST /mcp — the endpoint ChatGPT connects to.
#
# ChatGPT custom MCP connectors accept only "no auth" or OAuth. They CANNOT send
# an arbitrary bearer token, so for the ChatGPT setup leave this UNSET and rely
# on an unguessable, short-lived HTTPS tunnel as the security boundary.
#
# Set it only when a client that can send headers (MCP Inspector, your own code)
# is the consumer.
# DESIGN_AGENT_SECRET=change-me

# Guards GET /ws — the Figma plugin's document-write channel. Our plugin UI CAN
# send this, and should. Set it even when /mcp is open, so a leaked tunnel URL
# cannot drive your Figma document.
#
# Paste the same value into the plugin panel's secret field.
# PLUGIN_SECRET=change-me-too

# Comma-separated origins allowed to call /mcp from a browser (MCP Inspector).
# ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,http://localhost:6274

# NODE_ENV=production
